# Public URL of the deployed site (used for canonical/OG tags, robots.txt, sitemap.xml).
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
VITE_SITE_URL=

# Contact form delivery: "mailto" (default, no backend), "formspree", or "api".
VITE_CONTACT_PROVIDER=mailto

# Formspree endpoint, e.g. https://formspree.io/f/abcdwxyz  (public by design, not a secret)
VITE_FORMSPREE_ENDPOINT=

# Your own backend endpoint (e.g. a FastAPI route) that accepts JSON {name, email, message}
VITE_CONTACT_API_URL=
